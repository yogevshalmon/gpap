+void Main::print_gpap_stats(uint64_t n_samples, double wall_s, bool final_line)
+{
+    //One machine-parseable line, flushed (endl) so a harness that KILLS this process on its
+    //time budget still sees every line printed before the kill. `final=1` marks the line
+    //emitted after the sampling loop: only that one carries an EXACT sample count, so a
+    //harness can tell "CMSGen finished/stopped cleanly with n samples" from "CMSGen was killed
+    //somewhere after its n-th cadence line" instead of silently publishing a floored count.
+    cout
+    << "c gpap-stats"
+    << " samples=" << n_samples
+    << " props=" << solver->get_sum_propagations()
+    << " decisions=" << solver->get_sum_decisions()
+    << " conflicts=" << solver->get_sum_conflicts()
+    << " cpu_s=" << std::fixed << std::setprecision(4) << cpuTime()
+    << " wall_s=" << std::fixed << std::setprecision(4) << wall_s
+    << " final=" << (final_line ? 1 : 0)
+    << endl;
+}
+
 lbool Main::multi_solutions() {
-    cout << "c Writing samples to file: " << resultFilename << endl;
+    if (!nowrite) cout << "c Writing samples to file: " << resultFilename << endl;
+    const auto t_start = std::chrono::steady_clock::now();
+    auto wall = [&]() {
+        return std::chrono::duration<double>(
+            std::chrono::steady_clock::now() - t_start).count();
+    };
     unsigned long current_nr_of_solutions = 0;
     lbool ret = l_True;
+    bool hit_deadline = false;
     while(current_nr_of_solutions < max_nr_of_solutions && ret == l_True) {
+        if (max_time_s > 0) {
+            const double left = max_time_s - wall();
+            if (left <= 0) { hit_deadline = true; break; }
+            //Solver::solve() resets conf.maxTime when it returns, so the budget is re-armed
+            //every iteration. This is what makes the reported count EXACT under a time budget:
+            //the solver returns l_Undef at the deadline and falls out to the final stats line
+            //below, instead of being killed between two cadence lines. (The solver compares
+            //against CPU time while this loop measures wall, so a heavily swapping host can
+            //overrun slightly — a harness should still keep a kill as a backstop.)
+            solver->set_max_time(left);
+        }
         ret = solver->solve(NULL, only_sampling_solution);
-        current_nr_of_solutions++;
-        if (ret == l_True && current_nr_of_solutions < max_nr_of_solutions) {
+        if (ret != l_True) {
+            //l_Undef here can only be the deadline: no conflict budget is ever set.
+            hit_deadline = (ret == l_Undef);
+            break;                              //l_False = the formula is exhausted/unsat
+        }
+        current_nr_of_solutions++;              //count SOLUTIONS, not solve() calls
+        if (current_nr_of_solutions < max_nr_of_solutions) {
             //printResultFunc(&cout, false, ret);
             if (resultfile) printResultFunc(resultfile, true, ret);
-            if (current_nr_of_solutions % 10 == 0) {
+            if (stats_every && current_nr_of_solutions % stats_every == 0) {
+                print_gpap_stats(current_nr_of_solutions, wall(), false);
+            }
+            //The every-10 console line is a flush per 10 samples: kept for the default
+            //(file-writing) mode so stock behaviour is unchanged, suppressed in --nowrite
+            //mode where console I/O would be measured as sampling time.
+            if (!nowrite && current_nr_of_solutions % 10 == 0) {
                 cout
                 << "c Number of samples found until now: "
                 << std::setw(6) << current_nr_of_solutions
@@ -331,6 +405,12 @@ lbool Main::multi_solutions() {
             }
         }
     }
+    print_gpap_stats(current_nr_of_solutions, wall(), true);
+    if (hit_deadline) {
+        cout << "c gpap-maxtime reached after " << std::fixed << std::setprecision(4)
+             << wall() << "s" << endl;
+        return l_Undef;
+    }
     return ret;
 }
 
